// Prisma schema for the FairGig Grievance Service
// Database: PostgreSQL 16
// Run after setting DATABASE_URL in .env:
//   npx prisma generate          — generate the Prisma Client
//   npx prisma db pull           — if DB already exists, introspect it instead
//   npx prisma migrate dev       — if managing migrations via Prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Referenced tables (managed by SQLAlchemy / Alembic in other services) ────
// Prisma needs to know about these so foreign keys resolve.
// We declare them here as read-only references — do NOT run prisma migrate
// on these; they are owned by the auth / earnings services.

model users {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String       @unique @db.VarChar(255)
  display_name String       @db.VarChar(100)
  role         String       @db.VarChar(20)
  created_at   DateTime?    @default(now()) @db.Timestamp(6)
  grievances   grievances[]

  @@map("users")
}

model platforms {
  id         String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String       @unique @db.VarChar(100)
  category   String       @db.VarChar(30)
  created_at DateTime?    @default(now()) @db.Timestamp(6)
  grievances grievances[]

  @@map("platforms")
}

// ── Grievance service owns these two tables ───────────────────────────────────

model grievances {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  worker_id        String           @db.Uuid
  platform_id      String           @db.Uuid
  category         String           @db.VarChar(30)
  description      String
  status           String           @default("open") @db.VarChar(20)
  is_anonymous     Boolean          @default(true)
  resolution_notes String?
  created_at       DateTime?        @default(now()) @db.Timestamp(6)
  updated_at       DateTime?        @default(now()) @db.Timestamp(6)

  worker           users            @relation(fields: [worker_id], references: [id], onDelete: Cascade)
  platform         platforms        @relation(fields: [platform_id], references: [id])
  grievance_tags   grievance_tags[]

  @@index([platform_id, category, created_at(sort: Desc)], map: "idx_grievances_platform_category")
  @@index([platform_id, category, created_at], map: "idx_grievances_cluster")
  @@map("grievances")
}

model grievance_tags {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  grievance_id String     @db.Uuid
  tag          String     @db.VarChar(50)

  grievance    grievances @relation(fields: [grievance_id], references: [id], onDelete: Cascade)

  @@unique([grievance_id, tag], map: "uq_grievance_tag")
  @@index([grievance_id], map: "idx_tags_grievance")
  @@index([tag], map: "idx_tags_tag")
  @@map("grievance_tags")
}
